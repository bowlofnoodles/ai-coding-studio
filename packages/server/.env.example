DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=ai_coding_studio
SANDBOX_IMAGE=ai-coding-studio-sandbox:latest

# Docker socket path (leave empty for default /var/run/docker.sock)
# Rancher Desktop: /Users/<username>/.rd/docker.sock
DOCKER_SOCKET=

# ---- Claude Code credentials (choose one mode) ----

# Mode 1: Direct Anthropic API
ANTHROPIC_API_KEY=

# Mode 2: MiniMax proxy (https://platform.minimaxi.com)
# ANTHROPIC_AUTH_TOKEN=your-minimax-api-key
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# ANTHROPIC_MODEL=MiniMax-M2.7
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# API_TIMEOUT_MS=3000000
